# Backend API Configuration

## API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

## Database
DATABASE_URL=postgresql://smart_trade:smart_trade_password@localhost:5432/smart_trade_db

## JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

## CORS Configuration
FRONTEND_URL=http://localhost:3000

## Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SIGNALS_TOPIC=trading-signals
KAFKA_TRADES_TOPIC=trading-trades
KAFKA_PRICES_TOPIC=price-updates

## Broker Configuration (Angel One)
BROKER_API_KEY=your_angel_one_api_key
BROKER_API_SECRET=your_angel_one_api_secret
BROKER_NAME=angel_one

## Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

## Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

## Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_REAL_TIME_PRICES=true
ENABLE_LIVE_TRADING=false
